                                                    <Value>=iif(Fields!FournisseurPoseur.Value=False,Fields!Mentiontext.Value,Fields!Mentiontext.Value &amp; vbcrlf &amp; "Merci de nous envoyer systématiquement par Email avant le démarrage du chantier à l'adresse suivante ; compta@abrane.fr" &amp; vbcrlf &amp; "*Attestation multirisques professionnelle pour l'année en cours" &amp; vbcrlf &amp; "*Attestation d'assurance décennale pour l'année en cours" &amp; vbcrlf &amp; "*Attestation sur l'honneur certifiant que le travail sera réalisé avec des salariés employés régulièrement au regard des articles L143-3, L143-5 et L620-3 du Code du Travail" &amp; vbcrlf &amp; "*Attestation de non condamnation relative au travail illégal au titre des 5 dernières années" &amp; vbcrlf &amp; "*Extrait K-Bis de moins de 3 mois" &amp; vbcrlf &amp; "*Attestation URSSAF" &amp; vbcrlf &amp; "*Attestation Congés Payés (si vous êtes concerné)" &amp; vbcrlf &amp; "*Attestation fiscale" &amp; vbcrlf &amp; vbcrlf &amp; "Merci de renouveler ces documents tous les 6 mois")</Value>
                                                    <Style>
                                                      <FontFamily>Segoe UI</FontFamily>
                                                      <FontSize>8pt</FontSize>
                                                    </Style>
                                                  </TextRun>
                                                </TextRuns>
